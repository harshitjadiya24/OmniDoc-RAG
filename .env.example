# Copy to .env (git-ignored). Never commit real keys.
# Generate with: openssl rand -hex 32
SECRET_KEY=
AUTH_ENABLED=true
LLM_PROVIDER=ollama
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# Where browsers reach the services (used for CORS and the web build)
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
